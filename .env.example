# ---- Django ----
# Required when DEBUG is off. At least 32 characters. The placeholder below
# is too short, so copying this file into production will refuse to boot.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=generate-a-long-random-string
DEBUG=False
# Optional. If unset in production the app uses
# .up.railway.app,createch.co.ke,www.createch.co.ke — never "*".
ALLOWED_HOSTS=.railway.app,createch.co.ke,www.createch.co.ke
CSRF_TRUSTED_ORIGINS=https://createch.co.ke,https://www.createch.co.ke

# ---- Database (Railway Postgres — required in production) ----
# On the Railway web service set DATABASE_URL=${{Postgres.DATABASE_URL}}.
# Do not leave this unset: the app refuses to boot on SQLite outside tests.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_SSL_REQUIRE=False
# ALLOW_SQLITE=True   # local experiments only. Never set this on Railway.

# ---- Admin API auth ----
# The shared secret the Next PIN admin sends as the X-Admin-Key header.
# This MUST be byte-identical to ARCH_ADMIN_SECRET set on Vercel, and at least
# 32 characters — shorter values (like this placeholder) are refused outright.
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
ARCH_ADMIN_SECRET=generate-a-long-random-string

# ---- CORS (browsers allowed to call the API) ----
CORS_ALLOWED_ORIGINS=https://createch.co.ke,https://www.createch.co.ke

# ---- Media storage on a Railway volume ----
MEDIA_ROOT=/data/media
SERVE_MEDIA=True

# ---- Optional: Cloudflare R2 / S3 instead of the volume ----
# USE_S3=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=cdn.createch.co.ke

# ---- Enquiry email alerts (optional). Missing values skip the alert. ----
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=studio@createch.co.ke
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=studio@createch.co.ke
# ENQUIRY_NOTIFY_TO=anvi@createch.co.ke

# ---- Optional size caps (bytes). Defaults shown. ----
# DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
# FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
# ARCH_MAX_UPLOAD_BYTES=8388608
# ENQUIRY_MAX_BODY_BYTES=32768
# CHROME_MAX_BODY_BYTES=524288
